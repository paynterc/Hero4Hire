:root {
}

.player-info {
    flex-grow: 1;
    margin-top: 10px;
    margin-left: 10px;
    border-left-color: rgb(119, 255, 250);
    border-right-color: rgb(119, 255, 250);
    border-top-color: rgb(119, 255, 250);
    border-bottom-color: rgb(119, 255, 250);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
    border-bottom-left-radius: 9px;
    margin-bottom: 10px;
    margin-right: 10px;
    background-image: url("project://database/Assets/FlexibleColorPicker/Sprites/DefGrad_A_Hor.png?fileID=2800000&guid=ba5d461523497aa4a89188b483558a52&type=3#DefGrad_A_Hor");
    flex-direction: row;
    width: 500px;
    height: 88px;
    max-height: 88px;
}

.player-portrait {
    flex-grow: 1;
    flex-wrap: nowrap;
    align-self: center;
    align-items: flex-start;
    min-width: auto;
    max-width: 100%;
    min-height: auto;
    max-height: 100%;
    border-left-color: rgb(119, 255, 250);
    border-right-color: rgb(119, 255, 250);
    border-top-color: rgb(119, 255, 250);
    border-bottom-color: rgb(119, 255, 250);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    flex-direction: row;
    width: 100%;
    height: 100%;
}

.player-status-bar {
    align-self: flex-start;
    flex-grow: 0;
    min-width: auto;
    min-height: auto;
    max-width: initial;
    max-height: initial;
    align-content: auto;
    height: 50%;
    width: auto;
    flex-shrink: 0;
    flex-direction: row;
}

.player-portrait-container {
    width: 20px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(255, 1, 1);
    border-right-color: rgb(255, 1, 1);
    border-top-color: rgb(255, 1, 1);
    border-bottom-color: rgb(255, 1, 1);
    max-width: 20%;
    height: 82px;
    min-width: 20px;
}


